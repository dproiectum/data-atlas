{
  "name": "data-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/validate-content.mjs && astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "validate": "node scripts/validate-content.mjs",
    "add": "node scripts/new-entry.mjs",
    "build:local": "npm run build && node scripts/export-local.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
